# Supabase Configuration
# Get these values from your Supabase project dashboard at https://supabase.com/dashboard

# Your Supabase project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase anonymous/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY="your-anon-key-here"

# Alternative name for the anon key (if using different naming convention)
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key-here"

# Your Supabase project ID
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Service role key (NEVER expose this in frontend - only for server-side operations)
VITE_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# Instructions:
# 1. Copy this file to .env
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Never commit the .env file to version control